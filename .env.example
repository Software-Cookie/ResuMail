# Copy to .env (never commit .env). All values are optional.
PORT=3000

# --- Optional: a sender stored on the server ---
# If you set these AND an ACCESS_KEY, the website offers "Use server sender".
# Visitors must type the ACCESS_KEY to send from this account, so strangers can't use it.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=you@gmail.com
# SMTP_PASS=your16charapppassword
# SMTP_FROM_NAME=Your Name
# SMTP_FROM_EMAIL=you@gmail.com
# ACCESS_KEY=pick-a-long-random-secret
