# Copy to .env for local use (never commit .env). On Vercel, add these in
# Project → Settings → Environment Variables instead.

PORT=3000

# --- Database (required in production) ---
# Neon Postgres connection string. Leave empty locally to use the built-in
# development database stored in ./.data/db.
# DATABASE_URL=postgresql://user:password@ep-xxxx-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require

# --- Site ---
# Your public URL, used for SEO tags and the sitemap (auto-detected on Vercel).
# SITE_URL=https://resumail.vercel.app
# Shown on the legal pages and in the footer.
# SUPPORT_EMAIL=support@example.com

# --- Admin (needed for approving UPI payments and creating coupons) ---
# Comma-separated account emails that may open /admin.html
# ADMIN_EMAILS=you@gmail.com
# A long random secret (at least 16 characters) typed into the admin panel
# ADMIN_KEY=change-me-to-a-long-random-secret

# --- Payments ---
# UPI (free, personal account): payers scan a QR for this UPI ID and submit the UTR.
# UPI_ID=yourname@okaxis
# UPI_NAME=Your Name
# Razorpay (optional, automatic activation; fees apply per payment)
# RAZORPAY_KEY_ID=rzp_live_xxxxxxxx
# RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxx

# --- Service email (password reset codes and payment notices) ---
# Use a Gmail address with a 16-character App Password.
# SMTP_USER=you@gmail.com
# SMTP_PASS=abcdefghijklmnop
# SMTP_FROM_NAME=ResuMail
# Optional: lets visitors who know ACCESS_KEY send through this account too.
# ACCESS_KEY=pick-a-long-random-secret
